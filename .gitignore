# ---- Dataset -------------------------------------------------------------
# The Garbage Classification v2 images are not redistributed here.
# See README.md -> "Dataset" for the download instructions.
#
# Every pattern below is anchored with a leading slash so it matches only the
# generated directory at the repository root. Unanchored, `data/` would also
# swallow docs/data/, which the published demo needs.
/data/

# ---- Training artifacts --------------------------------------------------
# Weights are published as GitHub Release assets, not committed.
/checkpoints/
/experiments/
/tensorboard/
/splits/
*.pt
*.pth
*.ckpt

# Figures and tables regenerated by scripts/evaluate.py. The subset the demo
# site serves is committed separately under docs/figures/.
/reports/

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- Virtual environments ------------------------------------------------
.venv/
venv/
ENV/
env/
.python-version

# ---- Jupyter -------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---- Tooling / IDE -------------------------------------------------------
.idea/
.vscode/
*.iml
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ---- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
